# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/garderob_men"

# HTTP port the Node process listens on (Nginx proxies /api and /uploads to this)
PORT=4000

# Origin(s) allowed to call this API (the deployed frontend's URL)
CORS_ORIGIN="https://garderob.men"

# JWT signing secret for admin auth — use a long random string in production
JWT_SECRET="change-me-to-a-long-random-string"

# Seeded on first `npm run prisma:seed` — the one admin account
ADMIN_EMAIL="owner@garderob.men"
ADMIN_PASSWORD="change-me"

# Where uploaded product images are written on disk (served statically at /uploads)
UPLOADS_DIR="./uploads"

# "mock" until a real acquirer is approved — enables POST /api/dev/mock-pay/:orderId and
# skips calling any real payment API. Switch to "live" once PAYMENT_PROVIDER's credentials
# below are issued.
PAYMENT_MODE="mock"

# Which real acquirer to use once PAYMENT_MODE=live: "kaspi" (direct Kaspi Pay merchant
# application) or "tiptop" (TipTop Pay, an alternative KZ acquirer — see
# src/services/payment/tipTopPayService.ts for why it's an option). Defaults to "kaspi"
# if unset.
PAYMENT_PROVIDER="kaspi"

# Issued by Kaspi once the merchant application is approved (see src/services/payment/kaspiPayService.ts)
KASPI_MERCHANT_ID=""
KASPI_API_TOKEN=""
# Shared secret used to verify POST /api/webhooks/kaspi really came from Kaspi
KASPI_WEBHOOK_SECRET="change-me"

# Issued by TipTop Pay once a merchant agreement is signed — field names are placeholders,
# confirm the real ones against TipTop's integration docs (see tipTopPayService.ts)
TIPTOP_TERMINAL_KEY=""
TIPTOP_API_KEY=""
# Shared secret used to verify POST /api/webhooks/tiptop really came from TipTop
TIPTOP_WEBHOOK_SECRET="change-me"

# Fiscalization (Webkassa/Rekassa) — see src/services/fiscal/webkassaFiscalService.ts
WEBKASSA_API_KEY=""
WEBKASSA_CASHBOX_ID=""
