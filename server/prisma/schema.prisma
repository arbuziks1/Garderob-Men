generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  VERKHNYAYA_ODEZHDA
  HUDI_I_SVITSHOTY
  BRYUKI_I_DZHINSY
  KOSTYUMY_I_RUBASHKI
  OBUV_I_AKSESSUARY
}

enum Fit {
  OVERSIZE
  REGULAR
  SLIM
}

enum DeliveryMethod {
  SELF_PICKUP
  DELIVERY
}

enum PaymentMethod {
  KASPI_QR
  TRANSFER
  CASH
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  SHIPPED
  DELIVERED
}

enum SizeFit {
  SMALL_FIT    // Маломерит
  TRUE_TO_SIZE // Идёт размер в размер
  BIG_FIT      // Большемерит
}

// Per-category sequential counter used to generate SKUs like GM-OUT-0014.
model CategorySkuCounter {
  category   Category @id
  lastNumber Int      @default(0)
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  title       String
  category    Category
  fit         Fit
  sizeFit     SizeFit?
  price       Int
  oldPrice    Int?
  description String
  modelNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Product-card attributes shown the way Kaspi Магазин shows them (researched from
  // live Kaspi listings — brand/country/season/composition are near-universal across
  // categories, everything else varies too much per category for its own column).
  brand            String?
  countryOfOrigin  String?
  season           String?
  material         String?
  composition      String?
  characteristics  Json? // free-form { "Силуэт": "Oversize", "Застёжка": "Молния", ... }

  colors     ProductColor[]
  orderItems OrderItem[]
}

model ProductColor {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name     String
  hex      String
  position Int    @default(0)

  images ProductImage[]
  sizes  ProductSizeStock[]

  @@index([productId])
}

model ProductImage {
  id       String       @id @default(cuid())
  colorId  String
  color    ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)
  url      String
  position Int          @default(0)

  @@index([colorId])
}

// Replaces the old fixed stockS/stockM/stockL/stockXl/stockXxl columns — a color can
// now have any number of size rows, each carrying whichever of the RU/EU/INT size-grid
// labels apply (a row may have only one of the three filled in, e.g. jeans waist sizes
// are INT-only: sizeInt="W30", sizeRu/sizeEu left null).
model ProductSizeStock {
  id      String       @id @default(cuid())
  colorId String
  color   ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)

  sizeRu   String?
  sizeEu   String?
  sizeInt  String?
  stock    Int    @default(0)
  position Int    @default(0)

  orderItems OrderItem[]

  @@index([colorId])
}

model Order {
  id             String         @id @default(cuid())
  customerName   String
  phone          String
  deliveryMethod DeliveryMethod
  paymentMethod  PaymentMethod
  subtotal       Int
  discount       Int            @default(0)
  promoCode      String?
  total          Int
  status         OrderStatus    @default(PENDING_PAYMENT)
  comment        String?

  consentGiven   Boolean   @default(false)
  consentGivenAt DateTime?

  paymentTransactionId String?
  fiscalReceiptNumber  String?
  fiscalReceiptUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Nullable + SetNull so deleting a product later doesn't delete historical order rows
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Nullable + SetNull so deleting a size row (or the whole color) later doesn't delete
  // historical order rows — the size snapshot string below is what's actually displayed.
  sizeStockId String?
  sizeStock   ProductSizeStock? @relation(fields: [sizeStockId], references: [id], onDelete: SetNull)

  skuSnapshot       String
  titleSnapshot     String
  colorNameSnapshot String
  size              String // display label shown to the customer, e.g. "48 (RU)"
  priceSnapshot     Int
  quantity          Int

  @@index([orderId])
}

// Single-row table (always id = 1) holding the whole store's public settings
model StoreSettings {
  id            Int    @id @default(1)
  storeName     String
  address       String
  workingHours  Json
  whatsappPhone String
  phoneDisplay  String
  kaspiPayLink  String
  legalName     String
  businessId    String
  instagramUrl  String
  twoGisUrl     String
  heroTitle     String
  heroSubtitle  String
  heroImage     String
  heroCtaLabel  String
}

model PromoCode {
  id              String  @id @default(cuid())
  code            String  @unique
  discountPercent Int
  active          Boolean @default(true)
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
