generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  KURTKI_I_PUKHOVIKI
  PALTO_I_PLASHCHI
  PIDZHAKI_I_KOSTYUMY
  HUDI_I_TOLSTOVKI
  SVITSHOTY_I_DZHEMPERY
  SVITERY_I_KARDIGANY
  RUBASHKI
  FUTBOLKI_I_POLO
  BRYUKI
  DZHINSY
  SHORTY
  OBUV
  REMNI
  SUMKI_I_RYUKZAKI
  GOLOVNYE_UBORY_I_SHARFY
}

enum Fit {
  TO_WAIST
  TO_HIP
  BELOW_HIP
}

enum DeliveryMethod {
  SELF_PICKUP
  DELIVERY
}

enum PaymentMethod {
  CASH_ON_PICKUP
  CARD_ONLINE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  SHIPPED
  DELIVERED
}

enum SizeFit {
  SMALL_FIT // Маломерит
  TRUE_TO_SIZE // Идёт размер в размер
  BIG_FIT // Большемерит
}

// Per-category sequential counter used to generate SKUs like GM-OUT-0014.
model CategorySkuCounter {
  category   Category @id
  lastNumber Int      @default(0)
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  title       String
  category    Category
  fit         Fit
  sizeFit     SizeFit?
  price       Int
  oldPrice    Int?
  description String
  modelNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Product-card attributes shown the way Kaspi Магазин shows them (researched from
  // live Kaspi listings — brand/country/season/composition are near-universal across
  // categories, everything else varies too much per category for its own column).
  brand           String?
  countryOfOrigin String?
  season          String?
  material        String?
  composition     String?
  characteristics Json? // free-form { "Застёжка": "Молния", "Утеплитель": "Синтепон", ... }

  // Compact per-size measurements table in cm, independent of per-color stock:
  // { rows: ["Длина изделия", ...], values: { "Длина изделия": { "48 (M)": 70, ... } } }.
  // Column keys are the combined RU/EU+INT size label (see combinedSizeLabel on the
  // frontend) so one row of numbers covers a size regardless of which color it's on.
  measurements Json?

  colors     ProductColor[]
  orderItems OrderItem[]
}

model ProductColor {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name     String
  hex      String
  position Int    @default(0)

  images ProductImage[]
  sizes  ProductSizeStock[]

  @@index([productId])
}

model ProductImage {
  id       String       @id @default(cuid())
  colorId  String
  color    ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)
  url      String
  position Int          @default(0)

  @@index([colorId])
}

// Replaces the old fixed stockS/stockM/stockL/stockXl/stockXxl columns — a color can
// now have any number of size rows, each carrying whichever of the RU/EU/INT size-grid
// labels apply (a row may have only one of the three filled in, e.g. jeans waist sizes
// are INT-only: sizeInt="W30", sizeRu/sizeEu left null).
model ProductSizeStock {
  id      String       @id @default(cuid())
  colorId String
  color   ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)

  sizeRu   String?
  sizeEu   String?
  sizeInt  String?
  position Int     @default(0)

  // Stock is tracked per pickup branch, not as one flat number — see BranchStock.
  branchStocks BranchStock[]
  orderItems   OrderItem[]

  @@index([colorId])
}

// One of the store's two (or more) physical pickup shops. Replaces the single flat
// address/workingHours that used to live on StoreSettings — the store now has
// multiple physical locations, each with its own stock pool.
model PickupBranch {
  id           String  @id @default(cuid())
  name         String
  address      String
  workingHours Json // same WorkingHours[] shape StoreSettings.workingHours used — [{days, hours}]
  phone        String
  twoGisUrl    String?
  mapLat       Float?
  mapLng       Float?
  position     Int     @default(0)

  branchStocks BranchStock[]
  orders       Order[]
}

// Replaces the old flat ProductSizeStock.stock — the same size/color row can have a
// different stock number at each branch, and an order line decrements exactly one
// branch's row (see orderLifecycle.ts for the race-safe decrement pattern).
model BranchStock {
  id          String           @id @default(cuid())
  sizeStockId String
  sizeStock   ProductSizeStock @relation(fields: [sizeStockId], references: [id], onDelete: Cascade)
  branchId    String
  branch      PickupBranch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stock       Int              @default(0)

  orderItems OrderItem[]

  @@unique([sizeStockId, branchId])
  @@index([branchId])
}

model Order {
  id             String         @id @default(cuid())
  customerName   String
  phone          String
  deliveryMethod DeliveryMethod
  paymentMethod  PaymentMethod
  subtotal       Int
  discount       Int            @default(0)
  promoCode      String?
  total          Int
  status         OrderStatus    @default(PENDING_PAYMENT)
  comment        String?

  consentGiven   Boolean   @default(false)
  consentGivenAt DateTime?

  // Structured delivery address; present only for DELIVERY orders, null for self-pickup.
  deliveryAddress Json?

  // Which branch the customer picked for SELF_PICKUP orders; null for DELIVERY orders.
  // Snapshot kept alongside so the order's history stays readable even if the branch
  // is later renamed or deleted (same pattern as skuSnapshot/titleSnapshot below).
  pickupBranchId           String?
  pickupBranch             PickupBranch? @relation(fields: [pickupBranchId], references: [id], onDelete: SetNull)
  pickupBranchNameSnapshot String?

  paymentTransactionId String?
  fiscalReceiptNumber  String?
  fiscalReceiptUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Nullable + SetNull so deleting a product later doesn't delete historical order rows
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Nullable + SetNull so deleting a size row (or the whole color) later doesn't delete
  // historical order rows — the size snapshot string below is what's actually displayed.
  sizeStockId String?
  sizeStock   ProductSizeStock? @relation(fields: [sizeStockId], references: [id], onDelete: SetNull)

  // Which specific branch's stock pool this line item actually decremented — set for
  // every order regardless of delivery method (all stock ultimately comes from one of
  // the physical branches). Nullable + SetNull so deleting a branch later doesn't
  // delete historical order rows.
  branchStockId String?
  branchStock   BranchStock? @relation(fields: [branchStockId], references: [id], onDelete: SetNull)

  skuSnapshot       String
  titleSnapshot     String
  colorNameSnapshot String
  size              String // display label shown to the customer, e.g. "48 (RU)"
  priceSnapshot     Int
  quantity          Int

  @@index([orderId])
}

// Single-row table (always id = 1) holding the whole store's public settings
model StoreSettings {
  id            Int    @id @default(1)
  storeName     String
  whatsappPhone String
  phoneDisplay  String
  kaspiPayLink  String
  legalName     String
  businessId    String
  instagramUrl  String
  heroTitle     String
  heroSubtitle  String
  heroImage     String
  heroCtaLabel  String

  // Cashback program toggle + percent, shown as a customer's bonus balance in /api/customer/orders.
  bonusEnabled Boolean @default(false)
  bonusPercent Int     @default(0)
}

model PromoCode {
  id              String  @id @default(cuid())
  code            String  @unique
  discountPercent Int
  active          Boolean @default(true)
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Customer {
  id           String   @id @default(cuid())
  phone        String   @unique // normalized digits only, see lib/phone.ts
  passwordHash String
  createdAt    DateTime @default(now())
}
